# =============================================
# OffenSec AI — Environment Configuration
# =============================================
# Copy this file to .env and fill in values.
# Do not commit .env files to version control.

# --- Database ---
POSTGRES_USER=offensec
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
POSTGRES_HOST_PORT=5432

# --- Redis ---
REDIS_HOST_PORT=6379
REDIS_MAXMEMORY=512mb

# --- Authentication ---
# REQUIRED: Generate a secure random string (min 32 characters)
# Example: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=

# --- Backend API ---
BACKEND_HOST_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=production

# --- AI Model Runner ---
AI_MODEL_PROVIDER=local
# Options: local, ollama, openai, anthropic, azure
AI_MODEL_NAME=null
AI_MODEL_BASE_URL=http://ai-runner:8001
GPU_ENABLED=false
GPU_DEVICE=0
AI_MEMORY_LIMIT=4g
AI_RUNNER_HOST_PORT=8001

# --- Frontend ---
FRONTEND_HOST_PORT=3000
FRONTEND_API_URL=http://localhost:8000
FRONTEND_WS_URL=ws://localhost:8000/ws

# --- Plugin Sandbox ---
SANDBOX_HOST_PORT=8002
PLUGIN_REGISTRY_URL=http://plugin-sandbox:8002/plugins

# --- Scope & Security ---
SCOPE_ENFORCEMENT=true
PLUGIN_SANDBOX_ENABLED=true
